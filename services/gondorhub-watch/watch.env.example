# Copia este archivo a  watch.env  (mismo directorio) y rellena tus valores.
# NO lo subas a git y ponle  chmod 600  (el token da control total del bot).

# --- Telegram: reutiliza el docker-controller-bot ---
TELEGRAM_TOKEN=changeme     # el mismo TELEGRAM_TOKEN del bot
TELEGRAM_ADMIN=changeme     # tu chat id (TELEGRAM_ADMIN del bot)

DOMAIN=yourdomain.com

# --- Sensor externo (GitHub Actions -> Gist). Opcional pero recomendado. ---
# URL "raw" del gist SIN hash de commit: así siempre devuelve la última versión.
#GIST_RAW_URL=https://gist.githubusercontent.com/TU_USUARIO/TU_GIST_ID/raw/status.json

# --- Ajustes finos (por defecto entre paréntesis) ---
#RESOLVER=8.8.8.8            # DNS público para la reserva con dig (8.8.8.8)
#CURL_TIMEOUT=12             # segundos de espera al probar el dominio (12)
#TZ_DISPLAY=Europe/Madrid    # zona horaria de los mensajes (Europe/Madrid)
#STATE_DIR=/home/pi/.local/state/gondorhub-watch   # dónde guarda estado y log
