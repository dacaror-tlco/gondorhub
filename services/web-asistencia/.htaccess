# --- Web de asistencia · Juniors Axenia 603 D ---

DirectoryIndex index.php

# No listar carpetas
Options -Indexes

# Doble seguro: nada de lo que hay en /data ni /includes se sirve por web
RedirectMatch 404 ^/.*/data/.*\.json$
RedirectMatch 404 ^/.*/(includes|data)/

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# Cachear estáticos (los .css/.js llevan ?v= para forzar recarga al actualizar)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
